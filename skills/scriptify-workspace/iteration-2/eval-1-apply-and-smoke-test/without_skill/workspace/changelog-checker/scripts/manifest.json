{
  "skill": "changelog-checker",
  "scripts": [
    {
      "path": "scripts/list_changelogs.py",
      "step": 1,
      "purpose": "List changelog files sorted by version with a total count.",
      "good_invocations": [
        "python3 scripts/list_changelogs.py changelogs/",
        "python3 scripts/list_changelogs.py changelogs/ --json"
      ],
      "bad_data_invocations": [
        {
          "cmd": "python3 scripts/list_changelogs.py /nonexistent-dir",
          "expect": "exit 1 with 'error: not a directory'"
        },
        {
          "cmd": "python3 scripts/list_changelogs.py <empty dir>",
          "expect": "exit 0, 'total: 0'"
        }
      ]
    },
    {
      "path": "scripts/check_headers.py",
      "step": 2,
      "purpose": "Flag files missing the '## vX.Y.Z — YYYY-MM-DD' first line.",
      "good_invocations": [
        "python3 scripts/check_headers.py changelogs/",
        "python3 scripts/check_headers.py changelogs/ --json"
      ],
      "bad_data_invocations": [
        {
          "cmd": "python3 scripts/check_headers.py changelogs/",
          "expect": "exit 1, flags v1.2.0.md (missing version heading)"
        },
        {
          "cmd": "python3 scripts/check_headers.py <dir with empty .md>",
          "expect": "exit 1, 'no non-empty first line'"
        }
      ]
    },
    {
      "path": "scripts/count_entries.py",
      "step": 3,
      "purpose": "Count entries per category per file and across all files.",
      "good_invocations": [
        "python3 scripts/count_entries.py changelogs/",
        "python3 scripts/count_entries.py changelogs/ --json"
      ],
      "bad_data_invocations": [
        {
          "cmd": "python3 scripts/count_entries.py <dir with headings but no bullets>",
          "expect": "exit 0, all counts 0"
        }
      ]
    },
    {
      "path": "scripts/render_table.py",
      "step": 5,
      "purpose": "Render the markdown summary table, version descending.",
      "good_invocations": [
        "python3 scripts/render_table.py changelogs/",
        "python3 scripts/render_table.py changelogs/ --include-misc"
      ],
      "bad_data_invocations": [
        {
          "cmd": "python3 scripts/render_table.py <dir where a file lacks a header>",
          "expect": "exit 0, date cell shows '(missing)'"
        }
      ]
    },
    {
      "path": "scripts/check_categories.py",
      "step": 6,
      "purpose": "Validate category tags; list Misc entries for Claude to judge.",
      "good_invocations": [
        "python3 scripts/check_categories.py changelogs/",
        "python3 scripts/check_categories.py changelogs/ --json"
      ],
      "bad_data_invocations": [
        {
          "cmd": "python3 scripts/check_categories.py <dir with a '### Bogus' section>",
          "expect": "exit 1, 'unknown category'"
        }
      ]
    }
  ],
  "not_delegated": [
    {
      "step": 4,
      "reason": "Release narrative for a non-technical reader is open-ended writing."
    },
    {
      "step": 6,
      "reason": "Judging whether a Misc entry belongs in another category is semantic."
    },
    {
      "step": 7,
      "reason": "Judging whether an entry reads clearly is semantic."
    }
  ]
}
